{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 4,
  "singleQuote": true,
  "printWidth": 100,
  "ignorePatterns": ["node_modules", "build", "src/xray-protos"],
  "overrides": [
    {
      "files": [
        "*.json",
        "**/*.json",
        "*.jsonc",
        "**/*.jsonc",
        "*.yaml",
        "**/*.yaml",
        "*.yml",
        "**/*.yml",
        "*.md",
        "**/*.md"
      ],
      "options": { "tabWidth": 2 }
    }
  ],
  "sortImports": {
    "newlinesBetween": true,
    "internalPattern": ["~/**"],
    "groups": [
      "type",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      { "newlinesBetween": false },
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ]
  }
}
