{
  "name": "@remnawave/xtls-sdk",
  "version": "0.17.0",
  "description": "A Typescript SDK for XRAY (XTLS) Core GRPC Api",
  "keywords": [
    "api",
    "client",
    "grpc",
    "network",
    "protocol",
    "proxy",
    "sdk",
    "trojan",
    "typescript",
    "vless",
    "xray",
    "xray core api",
    "xray-core",
    "xtls"
  ],
  "homepage": "https://github.com/remnawave/xtls-sdk#readme",
  "bugs": {
    "url": "https://github.com/remnawave/xtls-sdk/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "Remnawave <https://github.com/remnawave>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remnawave/xtls-sdk.git"
  },
  "files": [
    "build/**/*"
  ],
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "prepublish": "rm -rf build && tsc",
    "build": "tsc",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "oxfmt --check && oxlint",
    "fix": "oxfmt && oxlint --fix"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "long": "^5.3.2",
    "nice-grpc": "^2.1.17",
    "protobufjs": "^8.8.0"
  },
  "devDependencies": {
    "@types/node": ">= 24 < 25",
    "eslint-plugin-perfectionist": "5.11.0",
    "grpc-tools": "^1.13.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tar": "^7.5.22",
    "ts-proto": "^2.12.1",
    "typescript": "~5.9.3"
  }
}
